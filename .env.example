# Puerto de la aplicación (Railway lo asigna automáticamente)
PORT=3000

# Base de datos:
# En Railway: al añadir el plugin PostgreSQL, DATABASE_URL se configura solo.
# En Local: si dejas DATABASE_URL vacío, usa SQLite local en ./data/vocab.sqlite sin requerir nada instalado.
DATABASE_URL=

# Dominio público (Railway lo provee en Settings -> Networking -> Generate Domain)
RAILWAY_PUBLIC_DOMAIN=
# O URL completa personalizada (ej: https://mi-app.up.railway.app)
APP_URL=

# ================= GOOGLE CLOUD (DRIVE & CALENDAR) =================
# JSON completo de la clave de la cuenta de servicio de Google Cloud (o ruta a service-account.json)
# Debe tener permisos de lectura en la carpeta de Drive y de escritura en el calendario.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID de la carpeta de Google Drive donde guardas el Excel (la parte final de la URL en drive.google.com/drive/folders/...)
GOOGLE_DRIVE_FOLDER_ID=

# ID del Google Calendar donde se crearán los eventos diarios de repaso (ej: 'primary' o tu_correo@gmail.com)
GOOGLE_CALENDAR_ID=primary

# ================= TELEGRAM BOT =================
# Token provisto por @BotFather al crear tu bot
TELEGRAM_BOT_TOKEN=

# Tu Chat ID personal de Telegram (opcional: al escribir /start en tu bot se guarda solo)
TELEGRAM_CHAT_ID=

# ================= PREFERENCIAS DE REPASO =================
# Hora del día para los recordatorios diarios (0 a 23, por defecto 9 = 9:00 AM)
REMINDER_HOUR=9

# Zona horaria para los eventos de Google Calendar
TIMEZONE=America/Bogota
